# Copy to .env.local (git-ignored) and fill in. Every value is optional: without it the feature is off.

# Course search proxy (see ../worker/README.md)
EXPO_PUBLIC_COURSE_API_URL=

# Crash reports (Sentry project → Settings → Client Keys). Public by design.
EXPO_PUBLIC_SENTRY_DSN=
# Opt-in usage analytics (Aptabase app key, "A-US-…" or "A-EU-…"). Public by design.
EXPO_PUBLIC_APTABASE_KEY=

# Build-time only, for uploading source maps and debug symbols. Keep these in EAS secrets, never in git.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
